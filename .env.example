# Supabase Configuration (required)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# JWT_SECRET: Secret key for signing JWT tokens. CHANGE THIS IN PRODUCTION.
JWT_SECRET="change-this-to-a-strong-random-secret"

# ADMIN_PASSWORD: Default admin password (only used on first run).
ADMIN_PASSWORD="kmadmin2026"

# PORT: Server port (default: 3000)
PORT=3000

# ALLOWED_ORIGIN: CORS allowed origin (default: * for development)
ALLOWED_ORIGIN="*"
